# Copy to .env (gitignored); the Makefile loads it automatically.

# GitHub token for `make release` (gh): classic with the `repo` scope, or
# fine-grained with Contents read/write on simonfranken/submarine.
GH_TOKEN=

# Optional override (default shown).
# GITHUB_REPO=simonfranken/submarine

# Bridge release only (`make release-gitea`, see docs/decisions.md D33):
# Gitea token with the write:package scope. Remove once the bridge is out.
GITEA_TOKEN=
# GITEA_URL=https://git.simon-franken.de
# GITEA_OWNER=simonfranken
