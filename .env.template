# Copy to .env (gitignored); the Makefile loads it automatically.

# GitHub token with contents:write on the repo, for `make release`.
# Not needed if `gh auth login` was run.
# GH_TOKEN=

# Optional override (default shown).
# GITHUB_REPO=simonfranken/submarine

# Bridge release only (`make release-gitea`): token with write:package scope.
GITEA_TOKEN=
# GITEA_URL=https://git.simon-franken.de
# GITEA_OWNER=simonfranken
